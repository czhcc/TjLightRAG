# Copy to docker/.env and fill every required value before production deployment.
# Use different passwords for runtime DML and schema migration.
DB_PASSWORD=
DB_MIGRATION_PASSWORD=
# Legacy V2 storage space: immutable after first migration; actual models are configured in the UI.
RAG_EMBEDDING_MODEL=legacy-bootstrap
RAG_VECTOR_DIMENSIONS=3
COOKIE_SECURE=true

# Inject a Base64-encoded 32-byte random AES key from a deployment secret store.
# Back it up with the database; never regenerate it on each restart.
RAG_MODEL_MASTER_KEY=
# Exact service hostnames, comma separated, no scheme or path. Empty denies outbound model calls.
RAG_MODEL_ALLOWED_HOSTS=
# Only for explicitly trusted local development HTTP endpoints; production should remain false.
RAG_MODEL_ALLOW_HTTP=false

# Per-instance retrieval admission and bounded model pipeline time.
RAG_RETRIEVAL_MAX_CONCURRENCY=4
RAG_RETRIEVAL_TIMEOUT_SECONDS=120
